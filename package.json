{
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "react-router build",
    "db:link": "varlock run -- sh -c 'pnpm exec supabase link --project-ref \"$SUPABASE_PROJECT_REF\" --password \"$SUPABASE_DB_PASSWORD\"'",
    "db:migration:new": "varlock run -- pnpm exec supabase db diff -f",
    "db:push": "varlock run -- pnpm exec supabase db push",
    "db:start": "./scripts/start-local-supabase.sh",
    "db:status": "pnpm exec supabase status -o env",
    "db:stop": "pnpm exec supabase stop",
    "db:restart": "pnpm db:stop && pnpm db:start",
    "db:types": "varlock run -- sh -c 'pnpm exec supabase gen types typescript --linked > app/models/database.types.ts'",
    "dev": "react-router dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "varlock run -- react-router-serve ./build/server/index.js",
    "test": "vitest --coverage",
    "test:coverage": "open coverage/index.html; vitest --coverage",
    "test:e2e:dev": "PW_USE_DEV_SERVER=1 pnpm exec playwright test --ui",
    "test:e2e:execute": "pnpm build && varlock run -- playwright test",
    "test:e2e:run": "./scripts/with-local-supabase.sh pnpm test:e2e:execute",
    "typecheck": "varlock codegen && react-router typegen && tsc -b",
    "validate": "run-p \"test -- --run\" format lint typecheck && pnpm test:e2e:run"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@mjackson/form-data-parser": "^0.9.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/vite": "^4.3.1",
    "@varlock/vite-integration": "^1.5.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "immer": "^11.1.4",
    "isbot": "^4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^15.0.0",
    "react-router": "^8.3.0",
    "recharts": "^3.7.0",
    "varlock": "^1.17.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.9.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.33.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "vite": "$vite"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
