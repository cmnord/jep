# Jep's environment contract. Local values belong in git-ignored `.env.local`.
# See https://varlock.dev/env-spec for the schema format.
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts, processEnv=loose, importMetaEnv=loose)
# ---

# Public origin used for canonical URLs, redirects, and the local dev-server port.
# @required @type=url
BASE_URL="http://localhost:3000"

# Signs application sessions. Use a long, random value outside local development.
# @required @sensitive @type=string(minLength=14)
SESSION_SECRET=

# Public URL for the Supabase project.
# @required @type=url
SUPABASE_URL="http://localhost:54321"

# Public/publishable key used by browser Supabase clients.
# @required
SUPABASE_ANON_KEY=

# Privileged key used only by the server. Never expose this to browser code.
# @required @sensitive
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project identifier used by linked CLI commands.
# @optional
SUPABASE_PROJECT_REF=

# Database password used by linked Supabase CLI commands.
# @optional @sensitive
SUPABASE_DB_PASSWORD=

# Personal access token used by the Supabase CLI.
# @optional @sensitive
SUPABASE_ACCESS_TOKEN=

# Playwright's test account. Defaults are only for the local Supabase stack.
# @optional @type=email
E2E_TEST_EMAIL="playwright@test.local"

# This is a shared local-test fixture, not a production credential.
# @optional
E2E_TEST_PASSWORD="test-password"

# Optional Playwright server and screenshot controls.
# @optional
HOST=

# @optional @type=number(isInt=true, min=1, max=65535)
PORT=

# @optional @type=enum(0, 1)
PW_USE_DEV_SERVER=

# Optional directory where the undo E2E test writes step-by-step screenshots.
# @optional
UNDO_SHOTS_DIR=

# Runtime mode used for production-only behavior such as secure cookies.
# @required @type=enum(development, test, production)
NODE_ENV="development"

# Set by the Vercel platform at build and runtime. Used to skip Vercel-only
# integrations in local production builds, where /_vercel/* endpoints do not
# exist.
# @required @type=boolean
VERCEL=false

# OAuth provider credentials used only by the local Supabase stack. Production
# providers are configured in the Supabase dashboard.
# @optional
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=

# @optional @sensitive
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# @optional
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=

# @optional @sensitive
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=

# @optional @sensitive
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# @optional @sensitive
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
